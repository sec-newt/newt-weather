<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Each permission is also listed, with its reason, in config/allowed-permissions.txt;
         the build fails if any other permission appears. -->

    <!-- The forecast comes from the National Weather Service (api.weather.gov), the only
         place this app connects to. Newt Weather is the only Newt app with internet access,
         so the others can show the weather while staying offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A notification for severe-weather Warnings only. Asked for only when you tap
         "Turn on warnings". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WorkManager adds this for long-running "foreground" work. A refresh takes seconds
         and never runs as foreground work, so it's removed rather than allowed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Newt">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
